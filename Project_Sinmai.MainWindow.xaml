<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Project_Sinmai.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:Project_Sinmai" Height="700" Width="950" Title="{w:Tr shell.title}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="5" Panel.ZIndex="999" Fill="{StaticResource WatermarkBrush}" IsHitTestVisible="False" />
    <GroupBox Grid.Row="1" Margin="10,5,10,5" Header="{w:Tr shell.params}">
      <StackPanel>
        <WrapPanel Margin="5">
          <StackPanel Margin="5">
            <TextBlock Text="{w:Tr shell.game}" />
            <ComboBox Name="CmbTitle" Width="180" SelectionChanged="CmbTitle_SelectionChanged">
              <ComboBoxItem Tag="SDGA" Content="{w:Tr shell.sdga}" />
              <ComboBoxItem Tag="SDGB" Content="{w:Tr shell.sdgb}" />
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="5">
            <TextBlock Text="{w:Tr shell.version}" />
            <TextBox Name="TxtVersion" Width="80" TextChanged="ConfigBox_TextChanged" />
          </StackPanel>
          <StackPanel Name="PnlSerial" Margin="5">
            <TextBlock Text="{w:Tr shell.clientId}" />
            <TextBox Name="TxtSerial" Width="130" TextChanged="ConfigBox_TextChanged" />
          </StackPanel>
          <StackPanel Name="PnlClientId" Margin="5">
            <TextBlock Text="{w:Tr shell.clientId}" />
            <TextBox Name="TxtClientId" Width="130" TextChanged="ConfigBox_TextChanged" />
          </StackPanel>
          <StackPanel Margin="5">
            <TextBlock Text="{w:Tr shell.downloadUa}" />
            <TextBox Name="TxtDownloadUa" Width="130" TextChanged="ConfigBox_TextChanged" />
          </StackPanel>
          <StackPanel Margin="5">
            <TextBlock Text="{w:Tr shell.persist}" />
            <CheckBox Name="ChkPersist" Margin="0,4,0,0" VerticalAlignment="Center" Content="{w:Tr shell.persistOn}" Checked="ChkPersist_Changed" Unchecked="ChkPersist_Changed" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Name="TxtVerHint" FontSize="11" Foreground="#FF808080" Margin="10,0,5,0" TextWrapping="Wrap" Text="{w:Tr shell.verHint}" />
        <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,0,5,5" TextWrapping="Wrap" Text="{w:Tr shell.uaHint}" />
        <GroupBox Margin="10,0,10,5" Header="{w:Tr shell.advanced}">
          <StackPanel>
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="5,0,5,5" TextWrapping="Wrap" Text="{w:Tr shell.advancedHint}" />
            <WrapPanel Margin="5">
              <StackPanel Margin="5">
                <TextBlock Text="InstructionUrl:" />
                <TextBox Name="TxtInstructionUrl" Width="330" TextChanged="ConfigBox_TextChanged" />
              </StackPanel>
              <StackPanel Margin="5">
                <TextBlock Text="InstructionUa:" />
                <TextBox Name="TxtInstructionUa" Width="130" TextChanged="ConfigBox_TextChanged" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
          <TextBlock VerticalAlignment="Center" Text="{w:Tr shell.downloadPath}" />
          <TextBox Name="TxtDownloadPath" Width="380" Margin="5,0,0,0" VerticalAlignment="Center" IsReadOnly="True" />
          <Button Width="80" Height="25" Margin="5,0,0,0" Content="{w:Tr shell.browse}" Click="BtnBrowseDownloadPath_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
          <TextBlock VerticalAlignment="Center" Text="{w:Tr shell.gamePath}" />
          <TextBox Name="TxtSinmaiPath" Width="380" Margin="5,0,0,0" VerticalAlignment="Center" IsReadOnly="True" />
          <Button Width="80" Height="25" Margin="5,0,0,0" Content="{w:Tr shell.browse}" Click="BtnBrowseSinmaiPath_Click" />
        </StackPanel>
        <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,0,5,5" TextWrapping="Wrap" Text="{w:Tr shell.sinmaiHint}" />
        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
          <CheckBox Name="ChkAutoUnpack" VerticalAlignment="Center" IsChecked="False" Content="{w:Tr shell.autoUnpack}" Checked="ChkAutoUnpack_Checked" />
        </StackPanel>
      </StackPanel>
    </GroupBox>
    <DockPanel Grid.Row="0" Margin="10,10,10,0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button Width="100" Height="30" Margin="0,0,10,0" Content="{w:Tr shell.initList}" Click="BtnInit_Click" />
        <Button Width="100" Height="30" Margin="0,0,10,0" Content="{w:Tr shell.downloadSelected}" Click="BtnDownloadSelected_Click" />
        <Button Width="100" Height="30" Content="{w:Tr shell.downloadAll}" Click="BtnDownloadAll_Click" />
        <Rectangle Width="1" Fill="#FFB4B4B4" Margin="16,4,16,4" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="11" Foreground="#FF808080" Margin="2,0,0,2" Text="{w:Tr shell.more}" />
          <StackPanel Orientation="Horizontal">
            <Button Width="100" Height="26" Content="{w:Tr shell.fileDecrypt}" Click="BtnFileDecrypt_Click" />
            <Button Width="100" Height="26" Margin="8,0,0,0" Content="{w:Tr shell.icfEdit}" Click="BtnIcfEdit_Click" />
            <Button Width="100" Height="26" Margin="8,0,0,0" Content="{w:Tr shell.scripts}" Click="BtnScripts_Click" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
        <TextBlock VerticalAlignment="Center" Text="{w:Tr shell.lang}" />
        <ComboBox Name="CmbLang" Width="120" Margin="4,0,0,0" SelectionChanged="CmbLang_SelectionChanged">
          <ComboBoxItem Content="简体中文" />
          <ComboBoxItem Content="繁體中文" />
          <ComboBoxItem Content="English" />
          <ComboBoxItem Content="日本語" />
        </ComboBox>
      </StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="2" Margin="10,5,10,0">
      <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="#FF808080" Margin="0,0,0,4" TextWrapping="Wrap" Text="{w:Tr shell.timeHint}" />
      <DataGrid Name="DgFiles" Margin="0,0,0,10" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" CanUserAddRows="False" CanUserDeleteRows="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="60" Header="{w:Tr shell.colSelect}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Click="CheckBox_Click" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="*" IsReadOnly="True" Header="{w:Tr shell.colName}" Binding="{Binding Name}" />
          <DataGridTextColumn Width="170" IsReadOnly="True" Header="{w:Tr shell.colOrder}" Binding="{Binding OrderTime}" />
          <DataGridTextColumn Width="170" IsReadOnly="True" Header="{w:Tr shell.colRelease}" Binding="{Binding ReleaseTime}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StatusBar Grid.Row="3">
      <StatusBarItem>
        <TextBlock Name="TxtStatus" Text="{w:Tr shell.ready}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Left" Margin="20,0,0,0">
        <TextBlock Name="TxtSpeed" Text="{w:Tr shell.speed}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <ProgressBar Name="PbProgress" Width="200" Height="15" />
      </StatusBarItem>
    </StatusBar>
    <Grid Row="4" Margin="10,4,10,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#C00000" TextWrapping="Wrap" Text="{w:Tr shell.footer}" />
      <TextBlock Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0">
        <Hyperlink NavigateUri="https://github.com/BlueShadow323/Project-Sinmai-Release" RequestNavigate="Link_RequestNavigate">
          <Run Text="https://github.com/BlueShadow323/Project-Sinmai-Release" />
        </Hyperlink>
      </TextBlock>
    </Grid>
  </Grid>
</Window>