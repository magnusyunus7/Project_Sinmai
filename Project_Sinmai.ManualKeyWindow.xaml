<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Project_Sinmai.ManualKeyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:Project_Sinmai" Height="420" Width="560" WindowStartupLocation="CenterOwner" Title="{w:Tr rune.title}">
  <Grid Margin="12">
    <Rectangle Margin="-12" Panel.ZIndex="999" Fill="{StaticResource WatermarkBrush}" IsHitTestVisible="False" />
    <StackPanel>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{w:Tr rune.hint}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Width="76" VerticalAlignment="Center" Text="{w:Tr rune.gameId}" />
        <TextBox Name="TxtId" Width="180" Height="26" MaxLength="16" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Width="76" VerticalAlignment="Center" Text="{w:Tr rune.key}" />
        <TextBox Name="TxtKey" Width="380" Height="26" FontFamily="Consolas" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Width="76" VerticalAlignment="Center" Text="{w:Tr rune.iv}" />
        <TextBox Name="TxtIv" Width="380" Height="26" FontFamily="Consolas" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Width="100" Height="28" Content="{w:Tr rune.decrypt}" Click="BtnOk_Click" />
        <Button Width="80" Height="28" Margin="8,0,0,0" Content="{w:Tr common.cancel}" Click="BtnCancel_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>