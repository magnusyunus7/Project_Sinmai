<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Project_Sinmai.ScriptEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:Project_Sinmai" Height="680" Width="780" WindowStartupLocation="CenterOwner" Title="{w:Tr form.title}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="2" Margin="-12" Panel.ZIndex="999" Fill="{StaticResource WatermarkBrush}" IsHitTestVisible="False" />
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Margin="0,0,0,8" Header="{w:Tr form.basic}">
          <StackPanel>
            <WrapPanel Margin="5">
              <StackPanel Margin="5">
                <TextBlock Text="{w:Tr shell.game}" />
                <ComboBox Name="CmbGame" Width="180" SelectionChanged="CmbGame_SelectionChanged">
                  <ComboBoxItem Tag="SDGA" Content="{w:Tr shell.sdga}" />
                  <ComboBoxItem Tag="SDGB" Content="{w:Tr shell.sdgb}" />
                </ComboBox>
              </StackPanel>
              <StackPanel Margin="5">
                <TextBlock Text="{w:Tr form.version}" />
                <TextBox Name="TxtVersion" Width="90" />
              </StackPanel>
              <StackPanel Name="PnlSerial" Margin="5">
                <TextBlock Text="Serial:" />
                <TextBox Name="TxtSerial" Width="130" />
              </StackPanel>
              <StackPanel Name="PnlClientId" Margin="5">
                <TextBlock Text="ClientId:" />
                <TextBox Name="TxtClientId" Width="130" />
              </StackPanel>
              <StackPanel Margin="5">
                <TextBlock Text="DownloadUa:" />
                <TextBox Name="TxtDownloadUa" Width="130" />
              </StackPanel>
              <StackPanel Margin="5">
                <TextBlock Text="{w:Tr form.maxNotify}" />
                <TextBox Name="TxtMaxNotify" Width="90" />
              </StackPanel>
            </WrapPanel>
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,0,5,0" TextWrapping="Wrap" Text="{w:Tr form.notifyHint}" />
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,0,5,5" TextWrapping="Wrap" Text="{w:Tr form.uaHint}" />
            <StackPanel Orientation="Horizontal" Margin="10,0,5,5">
              <TextBlock VerticalAlignment="Center" Text="{w:Tr form.downloadPath}" />
              <TextBox Name="TxtDownloadPath" Width="430" Margin="5,0,0,0" VerticalAlignment="Center" IsReadOnly="True" />
              <Button Width="80" Height="25" Margin="5,0,0,0" Content="{w:Tr form.browse}" Click="BtnBrowseDownloadPath_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,5,5">
              <TextBlock VerticalAlignment="Center" Text="{w:Tr form.gamePath}" />
              <TextBox Name="TxtSinmaiPath" Width="430" Margin="5,0,0,0" VerticalAlignment="Center" IsReadOnly="True" />
              <Button Width="80" Height="25" Margin="5,0,0,0" Content="{w:Tr form.browse}" Click="BtnBrowseSinmaiPath_Click" />
            </StackPanel>
            <CheckBox Name="ChkAutoDecrypt" Margin="10,5,0,5" Content="{w:Tr form.autoDecrypt}" />
          </StackPanel>
        </GroupBox>
        <GroupBox Margin="0,0,0,8" Header="{w:Tr form.advanced}">
          <StackPanel>
            <CheckBox Name="ChkUseAdvanced" Margin="10,5,0,5" Content="{w:Tr form.useAdvanced}" Checked="ChkUseAdvanced_Changed" Unchecked="ChkUseAdvanced_Changed" />
            <GroupBox Name="GbxAdvanced" Margin="10,0,10,8" IsEnabled="False" Header="{w:Tr form.advancedGroup}">
              <StackPanel>
                <TextBlock FontSize="11" Foreground="#FF808080" Margin="5,0,5,5" TextWrapping="Wrap" Text="{w:Tr form.advancedHint}" />
                <WrapPanel Margin="5">
                  <StackPanel Margin="5">
                    <TextBlock Text="InstructionUrl:" />
                    <TextBox Name="TxtInstructionUrl" Width="330" />
                  </StackPanel>
                  <StackPanel Margin="5">
                    <TextBlock Text="InstructionUa:" />
                    <TextBox Name="TxtInstructionUa" Width="130" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </GroupBox>
        <GroupBox Margin="0,0,0,8" Header="{w:Tr form.intervalGroup}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,5,0">
              <TextBlock VerticalAlignment="Center" Text="{w:Tr form.interval}" />
              <ComboBox Name="CmbInterval" Width="120" Margin="5,0,0,0" SelectionChanged="CmbInterval_SelectionChanged">
                <ComboBoxItem Tag="300" Content="{w:Tr form.min5}" />
                <ComboBoxItem Tag="600" Content="{w:Tr form.min10}" />
                <ComboBoxItem Tag="1200" Content="{w:Tr form.min20}" />
                <ComboBoxItem Tag="1800" Content="{w:Tr form.min30}" />
                <ComboBoxItem Tag="custom" Content="{w:Tr form.custom}" />
              </ComboBox>
              <TextBox Name="TxtIntervalSeconds" Width="90" Margin="15,0,0,0" VerticalAlignment="Center" IsEnabled="False" />
              <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="{w:Tr form.seconds}" />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,5,5,5" TextWrapping="Wrap" Text="{w:Tr form.intervalHint}" />
          </StackPanel>
        </GroupBox>
        <GroupBox Margin="0,0,0,8" Header="{w:Tr form.listGroup}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,5,0">
              <TextBlock VerticalAlignment="Center" Text="{w:Tr form.mode}" />
              <ComboBox Name="CmbListMode" Width="120" Margin="5,0,0,0">
                <ComboBoxItem Tag="blacklist" Content="{w:Tr form.blacklist}" />
                <ComboBoxItem Tag="whitelist" Content="{w:Tr form.whitelist}" />
              </ComboBox>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,5,5,5" TextWrapping="Wrap" Text="{w:Tr form.listHint}" />
            <TextBox Name="TxtListFiles" Height="90" Margin="10,0,10,8" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
          </StackPanel>
        </GroupBox>
        <GroupBox Margin="0,0,0,8" Header="{w:Tr form.windowGroup}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,5,0">
              <TextBlock VerticalAlignment="Center" Text="{w:Tr form.mode}" />
              <ComboBox Name="CmbWindowMode" Width="180" Margin="5,0,0,0" SelectionChanged="CmbWindowMode_SelectionChanged">
                <ComboBoxItem Tag="off" Content="{w:Tr form.windowOff}" />
                <ComboBoxItem Tag="exclude" Content="{w:Tr form.windowExclude}" />
                <ComboBoxItem Tag="include" Content="{w:Tr form.windowInclude}" />
              </ComboBox>
              <TextBox Name="TxtWindowStart" Width="70" Margin="15,0,0,0" VerticalAlignment="Center" IsEnabled="False" Text="00:00" />
              <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="{w:Tr form.to}" />
              <TextBox Name="TxtWindowEnd" Width="70" Margin="5,0,0,0" VerticalAlignment="Center" IsEnabled="False" Text="00:00" />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="10,5,5,5" TextWrapping="Wrap" Text="{w:Tr form.windowHint}" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Width="90" Height="28" Content="{w:Tr common.ok}" Click="BtnOk_Click" />
      <Button Width="90" Height="28" Margin="10,0,0,0" Content="{w:Tr common.cancel}" Click="BtnCancel_Click" />
    </StackPanel>
  </Grid>
</Window>