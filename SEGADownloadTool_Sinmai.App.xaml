<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="SEGADownloadTool_Sinmai.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:SEGADownloadTool_Sinmai" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <VisualBrush x:Key="WatermarkBrush" TileMode="Tile" Viewport="0,0,300,160" ViewportUnits="Absolute" Stretch="None" AlignmentX="Left" AlignmentY="Top">
        <VisualBrush.Visual>
          <Grid Width="300" Height="160">
            <TextBlock FontSize="16" Foreground="#26000000" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{w:Tr app.watermark}">
              <FrameworkElement.LayoutTransform>
                <RotateTransform Angle="-30" />
              </FrameworkElement.LayoutTransform>
            </TextBlock>
          </Grid>
        </VisualBrush.Visual>
      </VisualBrush>
    </ResourceDictionary>
  </Application.Resources>
</Application>