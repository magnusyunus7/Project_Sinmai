<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SEGADownloadTool_Sinmai.IcfEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:SEGADownloadTool_Sinmai" Height="620" Width="980" WindowStartupLocation="CenterOwner" Title="{w:Tr dint.title}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="3" Margin="-12" Panel.ZIndex="999" Fill="{StaticResource WatermarkBrush}" IsHitTestVisible="False" />
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Width="90" Height="28" Content="{w:Tr dint.load}" Click="BtnOpen_Click" />
      <Button Width="90" Height="28" Margin="8,0,0,0" Content="{w:Tr dint.save}" Click="BtnSave_Click" />
      <Button Width="90" Height="28" Margin="8,0,0,0" Content="{w:Tr dint.saveAs}" Click="BtnSaveAs_Click" />
      <Rectangle Width="1" Fill="#FFB4B4B4" Margin="12,4,12,4" />
      <TextBlock VerticalAlignment="Center" Text="{w:Tr dint.fileId}" />
      <TextBox Name="TxtIdA" Width="56" MaxLength="4" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="TxtId_TextChanged" />
      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{w:Tr dint.sysId}" />
      <TextBox Name="TxtIdB" Width="48" MaxLength="3" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="TxtId_TextChanged" />
    </StackPanel>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10*" />
        <ColumnDefinition Width="8*" />
      </Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Margin="0,0,6,0" Padding="6" Header="{w:Tr dint.list}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock VerticalAlignment="Center" Text="{w:Tr dint.newKind}" />
            <ComboBox Name="CmbNewKind" Width="100" Height="26" Margin="4,0,0,0" SelectedIndex="1">
              <ComboBoxItem Content="Pack" />
              <ComboBoxItem Content="App" />
              <ComboBoxItem Content="Opt" />
              <ComboBoxItem Content="App (delta)" />
            </ComboBox>
            <Button Width="80" Height="26" Margin="8,0,0,0" Content="{w:Tr dint.add}" Click="BtnAdd_Click" />
            <Button Width="80" Height="26" Margin="8,0,0,0" Content="{w:Tr dint.del}" Click="BtnDelete_Click" />
          </StackPanel>
          <Grid>
            <DataGrid Name="DgRows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" CanUserDeleteRows="False" AllowDrop="True" SelectionChanged="DgRows_SelectionChanged" PreviewMouseLeftButtonDown="DgRows_PreviewMouseLeftButtonDown" MouseMove="DgRows_MouseMove" PreviewMouseLeftButtonUp="DgRows_PreviewMouseLeftButtonUp" DragOver="DgRows_FileDragOver" Drop="DgRows_FileDrop">
              <DataGrid.Columns>
                <DataGridTextColumn Width="72" Header="{w:Tr dint.colKind}" Binding="{Binding KindText}" />
                <DataGridTextColumn Width="104" Header="{w:Tr dint.colVer}" Binding="{Binding Version}" />
                <DataGridTextColumn Width="148" Header="{w:Tr dint.colDate}" Binding="{Binding DateText}" />
                <DataGridTextColumn Width="*" Header="{w:Tr dint.colPreview}" Binding="{Binding Preview}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Foreground="#FF808080" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" Margin="20" Text="{w:Tr dint.emptyHint}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="0" Binding="{Binding ElementName=DgRows, Path=Items.Count}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </GroupBox>
      <GroupBox Grid.Column="1" Margin="6,0,0,0" Padding="6" Header="{w:Tr dint.detail}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Width="110" VerticalAlignment="Center" Text="{w:Tr dint.kind}" />
              <ComboBox Name="CmbKind" Width="120" Height="26" SelectionChanged="Detail_KindChanged">
                <ComboBoxItem Content="Pack" />
                <ComboBoxItem Content="App" />
                <ComboBoxItem Content="Opt" />
                <ComboBoxItem Content="App (delta)" />
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Width="110" VerticalAlignment="Center" Text="{w:Tr dint.ver}" />
              <TextBox Name="TxtVer" Width="150" Height="26" TextChanged="Detail_TextChanged" LostFocus="TxtVer_LostFocus" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Width="110" VerticalAlignment="Center" Text="{w:Tr dint.date}" />
              <TextBox Name="TxtDate" Width="170" Height="26" TextChanged="Detail_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Width="110" VerticalAlignment="Center" Text="{w:Tr dint.req}" />
              <TextBox Name="TxtReq" Width="150" Height="26" TextChanged="Detail_TextChanged" />
            </StackPanel>
            <GroupBox Margin="0,4,0,6" Padding="4" Header="{w:Tr dint.srcGroup}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Width="102" VerticalAlignment="Center" Text="{w:Tr dint.srcVer}" />
                  <TextBox Name="TxtSrcVer" Width="150" Height="26" TextChanged="Detail_TextChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Width="102" VerticalAlignment="Center" Text="{w:Tr dint.srcDate}" />
                  <TextBox Name="TxtSrcDate" Width="170" Height="26" TextChanged="Detail_TextChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="102" VerticalAlignment="Center" Text="{w:Tr dint.srcReq}" />
                  <TextBox Name="TxtSrcReq" Width="150" Height="26" TextChanged="Detail_TextChanged" />
                </StackPanel>
              </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Width="110" VerticalAlignment="Center" Text="{w:Tr dint.sfx}" />
              <TextBox Name="TxtSfx" Width="150" Height="26" TextChanged="Detail_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
              <TextBlock Width="110" VerticalAlignment="Center" Text="{w:Tr dint.preview}" />
              <TextBox Name="TxtPreview" Width="240" Height="44" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="#FF808080" Margin="0,4,0,0" TextWrapping="Wrap" Text="{w:Tr dint.dateHint}" />
            <Border Name="DropArea" Height="80" Margin="0,8,0,0" BorderBrush="#FF9A9A9A" BorderThickness="1" CornerRadius="6" Background="#FFF7F7F7" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF808080" FontSize="12" TextWrapping="Wrap" Margin="8,0" Text="{w:Tr dint.dropHint}" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </GroupBox>
    </Grid>
    <StatusBar Grid.Row="2">
      <StatusBarItem>
        <TextBlock Name="TxtStatus" Text="{w:Tr dint.ready}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>